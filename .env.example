# x402 Payment Configuration
WALLET_ADDRESS=0xYourWalletAddress
PRIVATE_KEY=0xYourPrivateKey
NETWORK=eip155:84532
RPC_URL=https://sepolia.base.org

# CDP Facilitator (required for payments)
CDP_API_KEY_ID=your-cdp-api-key-id
CDP_API_KEY_SECRET=your-cdp-api-key-secret

# Bypass payments for local development (never use in production)
BYPASS_PAYMENTS=true

# Agent Configuration
AGENT_NAME=Hello Agent
AGENT_DESCRIPTION=A simple Hello World agent with x402 payments
AGENT_URL=http://localhost:3000

# Server
PORT=3000

# Meter route (upto scheme ceiling per request)
METER_MAX_PRICE_PER_REQUEST=$0.50

# Agent Card (optional)
AGENT_PROVIDER_NAME=Your Organization
AGENT_PROVIDER_URL=https://example.com
AGENT_DOCS_URL=https://example.com/docs
AGENT_ICON_URL=https://example.com/icon.png

# ERC-8004 Identity (optional — set after first registration)
# AGENT_ID=1234

# IPFS (required for ERC-8004 registration)
PINATA_JWT=your-pinata-jwt
